generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USERS & AUTH
model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String        // bcrypt hash
  name          String
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relations
  photographer  Photographer?
  galleries     Gallery[]     @relation("PhotographerGalleries")
  
  @@map("users")
}

enum Role {
  USER
  PHOTOGRAPHER
  ADMIN
}

// PHOTOGRAPHERS (perfil estendido para fotógrafos)
model Photographer {
  id              String    @id @default(uuid())
  userId          String    @unique
  bio             String?
  portfolioUrl    String?
  instagram       String?
  facebook        String?
  phone           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("photographers")
}

// EVENTS (eventos/convenções)
model Event {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique // para URLs amigáveis
  description     String?   @db.Text
  date            DateTime
  location        String
  coverImageUrl   String?
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  galleries       Gallery[]
  
  @@map("events")
  @@index([date])
  @@index([published])
}

// GALLERIES (álbuns de fotos dentro de um evento)
model Gallery {
  id              String    @id @default(uuid())
  eventId         String
  photographerId  String
  title           String    // Ex: "Dia 1 - Manhã", "Estúdio - Perez"
  description        String?   @db.Text
  coverPhotoId       String?
  showcaseVideoUrl   String?
  published          Boolean   @default(false)
  photoCount      Int       @default(0) // denormalizado para performance
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographer    User      @relation("PhotographerGalleries", fields: [photographerId], references: [id])

  photos          Photo[]
  
  @@map("galleries")
  @@index([eventId])
  @@index([photographerId])
  @@index([published])
}

// PHOTOS (fotos individuais)
model Photo {
  id              String    @id @default(uuid())
  galleryId       String
  filename        String    // nome original do ficheiro
  s3Key           String    @unique // caminho no storage
  thumbnailKey    String?   // thumbnail pequeno
  mediumKey       String?   // versão média
  largeKey        String?   // versão grande
  originalKey     String    // original sem watermark
  width           Int
  height          Int
  fileSize        Int       // em bytes
  mimeType        String    // image/jpeg, image/png, etc
  tags            String[]  // array de tags
  caption         String?   @db.Text
  order           Int       @default(0) // ordem dentro da galeria
  published       Boolean   @default(true)
  uploadedAt      DateTime  @default(now())
  
  // Relations
  gallery         Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  
  @@map("photos")
  @@index([galleryId])
  @@index([published])
  @@index([tags])
}

// TAGS (para facilitar busca)
model Tag {
  id              String    @id @default(uuid())
  name            String    @unique
  slug            String    @unique
  category        TagCategory @default(OTHER)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())




  @@map("tags")
  @@index([category])
}

enum TagCategory {
  CHARACTER     // Personagens (Naruto, Goku, etc)
  SERIES        // Séries/Animes (One Piece, Naruto, etc)
  EVENT         // Tipo de evento (CCXP, Anime Friends, etc)
  PHOTOGRAPHER  // Fotógrafo específico
  STYLE         // Estilo (Studio, Outdoor, Casual, etc)
  OTHER
}